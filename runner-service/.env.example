# Copy to `.env` and adjust. Never commit a real key.

# API key required on POST /execute via the X-Runner-Key header.
# Leave empty to disable auth (local development only).
RUNNER_API_KEY=change-me-to-a-long-random-string

# Comma-separated CORS allow-list (exact origins of the frontend).
ALLOWED_ORIGINS=https://your-site.example.com,http://localhost:8000

# Hard request-size limit for code+tests in bytes (clamped to <= 131072).
MAX_REQUEST_BYTES=131072

# Timeouts in seconds (clamped: compile <= 300, run <= 60).
COMPILE_TIMEOUT=60
RUN_TIMEOUT=10

# Per-stream output truncation in bytes (clamped to <= 65536).
MAX_OUTPUT_BYTES=65536

# Max concurrent executions (clamped to <= 32).
MAX_CONCURRENT=4
